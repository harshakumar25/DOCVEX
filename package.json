{
  "name": "docvex",
  "version": "0.1.0",
  "description": "DocVex — Local-first acoustic technical tutor, Chrome extension, and LawBuddy statutory legal tutor",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "test": "node --test server/test/*.test.js",
    "lint": "node --check server/**/*.js extension/*.js",
    "certify": "node server/prismaguard/cli.js --all",
    "chaosflight": "node server/prismaguard/cli.js",
    "legal": "node --disable-warning=ExperimentalWarning node_modules/@docvex/lawbuddy/src/cli.js"
  },
  "dependencies": {
    "@docvex/lawbuddy": "git+https://github.com/harshakumar25/lawbuddy.git"
  },
  "keywords": [
    "local-first",
    "technical-tutor",
    "speech-synthesis",
    "legal-ai",
    "chrome-extension"
  ],
  "author": "",
  "license": "MIT"
}
