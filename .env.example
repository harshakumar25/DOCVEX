# DocVex Configuration

# Backend Server Port
PORT=3000

# Ollama Settings (Local-First Default)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Optional Cloud Model Provider (Groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Default Model Provider ('hybrid', 'groq', or 'ollama')
DEFAULT_PROVIDER=hybrid

# Selection Input Limits
MAX_SELECTION_LENGTH=12000

# Retrieval and background reasoning timeouts (ms)
RETRIEVAL_TIMEOUT_MS=2500
OLLAMA_BACKGROUND_TIMEOUT_MS=25000
OLLAMA_BACKGROUND_MAX_TOKENS=512

# Optional local Chatterbox sentence synthesis (requires explicit benchmarked model selection)
CHATTERBOX_ENABLED=false
CHATTERBOX_PYTHON=chatterbox/.venv/bin/python
CHATTERBOX_WORKER=chatterbox/docvex_worker.py
CHATTERBOX_MODEL=
CHATTERBOX_DEVICE=auto
CHATTERBOX_TEMP_DIR=.docvex-audio
CHATTERBOX_VOICE_PROMPT=chatterbox/voices/human_male_narrator.wav
CHATTERBOX_CFM_STEPS=8
CHATTERBOX_TEMPERATURE=0.65
CHATTERBOX_TOP_K=500
CHATTERBOX_TOP_P=0.90
CHATTERBOX_REP_PENALTY=1.3
CHATTERBOX_TARGET_SR=24000
CHATTERBOX_TARGET_LUFS=-19.0
EXTENSION_ORIGIN=
CHATTERBOX_STARTUP_TIMEOUT_MS=120000
CHATTERBOX_REQUEST_TIMEOUT_MS=120000
CHATTERBOX_MAX_QUEUE=30

# LawBuddy legal store (node:sqlite) and polite fetcher. Relative paths are resolved from the repo root.
LEGAL_DB_PATH=.lawbuddy/lawbuddy.db
LEGAL_RAW_DIR=.lawbuddy/raw
LEGAL_USER_AGENT="LawBuddyBot/0.1 (+educational legal research)"
LEGAL_FETCH_MIN_INTERVAL_MS=3000
LEGAL_FETCH_TIMEOUT_MS=30000
LEGAL_FETCH_MAX_BYTES=52428800
# PDF text extraction worker (python3 -m venv workers/.venv && workers/.venv/bin/pip install -r workers/requirements.txt).
# On an iCloud-synced Desktop, create the venv elsewhere (e.g. ~/.venvs/lawbuddy-pdf) and point to its absolute path:
# offloaded venv files make imports hang.
LEGAL_PYTHON=workers/.venv/bin/python
LEGAL_PDF_WORKER=workers/pdf_extract.py
LEGAL_PDF_TIMEOUT_MS=300000
