# DocVex Configuration

# Backend Server Port
PORT=3000

# Ollama Settings (Local-First Default)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Optional Cloud Model Provider (Groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Default Model Provider ('hybrid', 'groq', or 'ollama')
DEFAULT_PROVIDER=hybrid

# Selection Input Limits
MAX_SELECTION_LENGTH=12000

# Retrieval and background reasoning timeouts (ms)
RETRIEVAL_TIMEOUT_MS=2500
OLLAMA_BACKGROUND_TIMEOUT_MS=25000
OLLAMA_BACKGROUND_MAX_TOKENS=512

# Optional local Chatterbox sentence synthesis (requires explicit benchmarked model selection)
CHATTERBOX_ENABLED=false
CHATTERBOX_PYTHON=chatterbox/.venv/bin/python
CHATTERBOX_WORKER=chatterbox/docvex_worker.py
CHATTERBOX_MODEL=
CHATTERBOX_DEVICE=auto
CHATTERBOX_TEMP_DIR=.docvex-audio
CHATTERBOX_VOICE_PROMPT=chatterbox/voices/studio_male_voiceover.wav
EXTENSION_ORIGIN=
CHATTERBOX_STARTUP_TIMEOUT_MS=120000
CHATTERBOX_REQUEST_TIMEOUT_MS=120000
CHATTERBOX_MAX_QUEUE=30
