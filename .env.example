# DocVex Configuration

# Backend Server Host & Port (Bound strictly to localhost)
HOST=127.0.0.1
PORT=3000

# Ollama Settings (Local-First Default)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Optional Cloud Model Provider (Groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Default Model Provider ('ollama' or 'groq')
DEFAULT_PROVIDER=ollama

# Selection Input Limits
MAX_SELECTION_LENGTH=12000
